# Everything `flutter create` generates. Only the files that carry a
# decision are committed: pubspec.yaml, lib/main.dart, README.md,
# PHASE0_MESH_FINDINGS.md, plus the two Android files noted below.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.metadata
build/
ios/
linux/
macos/
windows/
web/
test/
analysis_options.yaml
*.iml
.idea/

# android/ is regenerated by `flutter create`, so it is ignored wholesale —
# EXCEPT two files that carry real, hard-won decisions and must survive a
# re-clone. Note this negates `android/**` (contents), not `android/`
# (the directory): git cannot re-include a file whose parent dir is excluded.
android/**
!android/
!android/app/
!android/app/src/
!android/app/src/main/
# BLE permissions for API 31+ and the maxSdkVersion=30 legacy block.
!android/app/src/main/AndroidManifest.xml
# kotlin.incremental=false — works around a Windows cross-drive Kotlin
# compiler bug (repo on D:, pub cache on C:). Without this the build fails.
!android/gradle.properties
